{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "invite-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "demo-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo"
      ],
      "port": 3100
    },
    {
      "name": "check-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3200"
      ],
      "env": {
        "NEXT_DIST_DIR": ".next-check"
      },
      "port": 3200
    }
  ]
}