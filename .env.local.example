# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: override the model
GEMINI_MODEL=gemini-3.5-flash

# Optional: 32-byte base64 key that encrypts provider API keys saved in Settings
APP_ENCRYPTION_KEY=

# Optional: PostgreSQL connection string (Supabase / Neon). When set, data is stored in the cloud.
# Copy local data once with: node --env-file=.env.local scripts/migrate-to-db.mjs
DATABASE_URL=
